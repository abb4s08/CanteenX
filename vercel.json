{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/src/main/resources/static/css/$1" },
    { "source": "/js/(.*)", "destination": "/src/main/resources/static/js/$1" },
    { "source": "/", "destination": "/src/main/resources/static/index.html" },
    { "source": "/(.*)", "destination": "/src/main/resources/static/$1" }
  ]
}
